     assert false { .asm = "adrp x16, #0x10000"; .opcode = "0x90000090" };
     assert false { .asm = "ldr x17, [x16, #0xf88]"; .opcode = "0xf947c611" };
     assert false { .asm = "add x16, x16, #0xf88"; .opcode = "0x913e2210" };
     assert false { .asm = "br x17"; .opcode = "0xd61f0220" };
     assert boolor();
     unreachable;
   ]
];