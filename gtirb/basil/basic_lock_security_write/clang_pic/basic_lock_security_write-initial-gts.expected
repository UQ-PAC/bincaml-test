     assert boolor(eq(0x6c0:bv64, $PC));
     goto (%frame_dummy_ext);
   ];
   block %frame_dummy_ext [
     assume eq(0x6c0:bv64, $PC);
     call @register_tm_clones();
     assert boolor();
     unreachable;
   ]
];
prog entry @_start;